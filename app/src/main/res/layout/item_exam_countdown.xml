<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="220dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvExamSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Computer Networks" />

        <TextView
            android:id="@+id/tvExamCountdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/priority_critical"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Exam in 3 days" />

        <TextView
            android:id="@+id/tvExamExactDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="May 14, 2026" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressExamPrep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:indicatorColor="@color/primary"
            app:trackColor="@color/primary_container"
            app:trackCornerRadius="4dp"
            app:trackThickness="6dp"
            tools:progress="48" />

        <TextView
            android:id="@+id/tvExamPrepText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="end"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="48% Prepared" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
