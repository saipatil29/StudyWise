<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvRevisionTopicTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="TCP 3-Way Handshake" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/spaced_repetition_prompt"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRecallHard"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Hard • Review in 1 day"
            android:textColor="@color/priority_critical"
            app:cornerRadius="10dp"
            app:strokeColor="@color/priority_critical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRecallOkay"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="Okay • Review in 3 days"
            android:textColor="@color/priority_high"
            app:cornerRadius="10dp"
            app:strokeColor="@color/priority_high" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRecallGood"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="Good • Review in 7 days"
            android:textColor="@color/secondary"
            app:cornerRadius="10dp"
            app:strokeColor="@color/secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRecallEasy"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="Easy • Review in 14 days"
            android:textColor="@color/primary"
            app:cornerRadius="10dp" />
    </LinearLayout>

</LinearLayout>
